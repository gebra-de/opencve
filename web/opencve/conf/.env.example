# PostgreSQL Database URL
OPENCVE_DATABASE_URL=postgresql://opencve:opencve@postgres:5432/opencve

# Django secret key
# Regenerate a new one with `$ python manage.py generate_secret_key`
OPENCVE_SECRET_KEY='django-insecure-8mjeblz2*z@_n&zn^xpo)(id8f90%@elj#t5dg)59hd69(553a'

# OpenCVE repositories paths
OPENCVE_KB_REPO_PATH=/app/repositories/opencve-kb
OPENCVE_MITRE_REPO_PATH=/app/repositories/cvelistV5
OPENCVE_NVD_REPO_PATH=/app/repositories/opencve-nvd
OPENCVE_REDHAT_REPO_PATH=/app/repositories/opencve-redhat
OPENCVE_VULNRICHMENT_REPO_PATH=/app/repositories/vulnrichment

# PostgreSQL DB URL of OpenCVE v1 (used for v1 -> v2 migration)
OPENCVE_V1_DATABASE=postgresql://opencve:opencve@postgres:5432/opencve_v1

# Base URL
OPENCVE_WEB_BASE_URL=https://app.opencve.io

# Internal networks that webhook and Slack notifications can target (comma-separated CIDRs)
# OPENCVE_NOTIFICATION_ALLOWED_INTERNAL_NETWORKS=10.0.0.0/8,192.168.1.0/24

# CVE Advanced Search
# Maximum number of fields allowed in a single advanced search query.
# Default: 5
# Increase this value for complex queries with multiple filters.
OPENCVE_CVES_ADVANCED_SEARCH_MAX_FIELDS=5

# -----------------------------------------------------------------------------
# Django SMTP Configuration
# -----------------------------------------------------------------------------
# By default, OpenCVE uses the Django console email backend.
# To enable SMTP delivery, uncomment and configure the following variables.
#
# All variables use the OPENCVE_ prefix defined in conf/base.py.
#
# Port 587: STARTTLS (EMAIL_USE_TLS=True, EMAIL_USE_SSL=False)
# Port 465: Implicit TLS (EMAIL_USE_TLS=False, EMAIL_USE_SSL=True)
# Do not enable both TLS options simultaneously.
#
# Never commit real credentials to this example file.

# OPENCVE_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# OPENCVE_EMAIL_HOST=mail.example.com
# OPENCVE_EMAIL_PORT=587
# OPENCVE_EMAIL_HOST_USER=notifications@example.com
# OPENCVE_EMAIL_HOST_PASSWORD=change_me
# OPENCVE_EMAIL_USE_TLS=True
# OPENCVE_EMAIL_USE_SSL=False
# OPENCVE_DEFAULT_FROM_EMAIL=notifications@example.com
# OPENCVE_SERVER_EMAIL=notifications@example.com
